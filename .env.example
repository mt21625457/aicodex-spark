# ============================================================================
# 远端服务（remote）示例配置
# 用法：
# 1) 复制本文件为 .env
# 2) 按实际环境修改值
# 3) 不要把真实密钥提交到 Git 仓库
# ============================================================================

# ----------------------------------------------------------------------------
# 1) 数据库与基础服务（核心必填）
# ----------------------------------------------------------------------------

# 远端服务使用的 PostgreSQL 连接串（必填）
# 格式：postgres://<user>:<password>@<host>:<port>/<database>
# 本地示例：docker-compose 默认常见端口为 5433
SERVER_DATABASE_URL=postgres://remote:remote@127.0.0.1:5433/remote

# ElectricSQL 服务地址（必填）
# 用于远端服务与 Electric 同步层通信
ELECTRIC_URL=http://127.0.0.1:3001

# Electric 数据库角色密码（必填）
# 需要与 Electric/数据库侧配置保持一致
ELECTRIC_ROLE_PASSWORD=change_me

# JWT 签名密钥（必填）
# 用于远端服务签发/校验登录令牌
# 生成命令：openssl rand -base64 48
VIBEKANBAN_REMOTE_JWT_SECRET=replace_with_base64_secret

# ----------------------------------------------------------------------------
# 2) OAuth 登录（至少配置一个提供方）
# ----------------------------------------------------------------------------

# GitHub OAuth 应用 Client ID（可选）
# 若启用 GitHub 登录，此项必填
GITHUB_OAUTH_CLIENT_ID=replace_with_github_client_id

# GitHub OAuth 应用 Client Secret（可选）
# 若启用 GitHub 登录，此项必填
GITHUB_OAUTH_CLIENT_SECRET=replace_with_github_client_secret

# Google OAuth 应用 Client ID（可选）
# 若启用 Google 登录，此项必填
GOOGLE_OAUTH_CLIENT_ID=

# Google OAuth 应用 Client Secret（可选）
# 若启用 Google 登录，此项必填
GOOGLE_OAUTH_CLIENT_SECRET=

# ----------------------------------------------------------------------------
# 3) 服务外部访问地址与通知
# ----------------------------------------------------------------------------

# 服务对外公开访问地址（建议配置）
# 用于生成回调链接、邮件链接、Review 链接
# 如你通过 server.sh 默认启动在 0.0.0.0:9999，可写实际可访问域名/IP
SERVER_PUBLIC_BASE_URL=http://127.0.0.1:9999

# Loops 邮件服务 API Key（可选）
# 留空表示关闭邮件通知能力
LOOPS_EMAIL_API_KEY=

# ----------------------------------------------------------------------------
# 4) Gitea PR Review（仅在启用 /v1/gitea/prreview 时需要）
# ----------------------------------------------------------------------------

# Gitea 评审数据根目录（启用 Gitea 时必填）
# clone 仓库、payload、投递记录都会写在该目录下
# 必须是“绝对路径”，服务启动时会校验可写权限
GITEA_PRREVIEW_REPO_DATA_DIR=/data/aicodex/gitea-prreview

# Gitea Webhook Secret（启用 Gitea 时必填）
# 必须与 Gitea Webhook 页面中的 Secret 完全一致
GITEA_PRREVIEW_WEBHOOK_SECRET=replace_with_gitea_webhook_secret

# Gitea API Token（启用 Gitea 时必填）
# 用于拉取 PR 元数据、回写评论、仓库访问
GITEA_PRREVIEW_TOKEN=replace_with_gitea_token

# 作业目录默认保留时长（小时，默认 24）
# 超时后清理任务会回收 jobs 目录中的历史数据
GITEA_PRREVIEW_RETENTION_HOURS=24

# webhook 原始投递记录保留时长（小时，默认 72）
# 目录：<repo_data_dir>/deliveries
GITEA_PRREVIEW_DELIVERY_RETENTION_HOURS=72

# 评审数据目录允许占用上限（GB，默认 20）
# 超出后会触发拒绝新任务保护
GITEA_PRREVIEW_MAX_TOTAL_GB=20

# 最低可用磁盘空间阈值（GB，默认 5）
# 低于该值时拒绝新任务，避免磁盘打满
GITEA_PRREVIEW_MIN_FREE_GB=5

# 单次仓库体积上限（MB，默认 2048）
# clone 后若超过该大小，任务会失败并记录原因
GITEA_PRREVIEW_MAX_REPO_SIZE_MB=2048

# 清理任务执行间隔（秒，默认 300）
# 影响历史目录回收速度与资源占用
GITEA_PRREVIEW_CLEANUP_INTERVAL_SECONDS=300

# 失败任务保留时长（小时，默认 12）
# 用于保留现场便于排障
GITEA_PRREVIEW_KEEP_FAILED_HOURS=12

# 回写 Gitea 评论最大重试次数（默认 3）
# 用于应对临时网络错误/上游抖动
GITEA_PRREVIEW_FEEDBACK_MAX_ATTEMPTS=3

# ----------------------------------------------------------------------------
# 5) Review Worker 与对象存储（完整评审链路需要）
# ----------------------------------------------------------------------------

# Review Worker 地址（建议必填）
# remote 会向该地址发送 /review/start
REVIEW_WORKER_BASE_URL=http://127.0.0.1:8082

# R2 Access Key ID（完整评审链路必填）
# 用于上传 payload.tar.gz 到对象存储
R2_ACCESS_KEY_ID=

# R2 Secret Access Key（完整评审链路必填）
R2_SECRET_ACCESS_KEY=

# R2 Endpoint（完整评审链路必填）
# 例如 Cloudflare R2 的 S3 兼容 endpoint
R2_REVIEW_ENDPOINT=

# R2 Bucket 名称（完整评审链路必填）
R2_REVIEW_BUCKET=
